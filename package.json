{
  "name": "registration-management-system",
  "private": true,
  "version": "1.0.0",
  "description": "Mobile-first registration management with WhatsApp (DXing) notifications and QR entry passes",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db": "npm --prefix server run db",
    "dev:server":"npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "create-admin": "npm --prefix server run create-admin --",
    "migrate": "npm --prefix server run migrate --",
    "test": "npm --prefix server test",
    "seed-site": "npm --prefix server run seed-site --",
    "check-indexes": "npm --prefix server run check-indexes"
  }
}
