# ---------------------------------------------------------------------------
# Registration Management System - server configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5100

# MongoDB for THIS application only (do not point at any other app's database)
MONGODB_URI=mongodb://127.0.0.1:27017/registration_system

# Public HTTPS origin of this server. DXing downloads the entry pass image from
# here, so it must be reachable from the internet when DXING_MODE=live.
PUBLIC_BASE_URL=https://your-domain.example

# Set to 1 when running behind one reverse proxy / load balancer (needed for
# correct client IPs in rate limiting). Leave empty when not behind a proxy.
TRUST_PROXY=

# Only needed if the client is hosted on a different origin during development.
CORS_ORIGINS=

# Admin sign-in for the admin console (the only account). Plain text, so keep
# this file private. Password: at least 10 characters. Changing either value
# and restarting the server signs out every existing session.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random strings (at least 32 characters each). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
PASS_SIGNING_SECRET=replace-with-a-different-long-random-string
SESSION_HOURS=12
# How long the signed pass-image link sent to DXing stays valid
PASS_IMAGE_LINK_MINUTES=60

# DXing WhatsApp API
#   mock = record messages in the database without sending (default)
#   live = send through DXing
DXING_MODE=mock
DXING_BASE_URL=https://app.dxing.in/api
DXING_API_KEY=
DXING_INSTANCE_ID=
DXING_TIMEOUT_MS=30000

# Event details used in WhatsApp messages and on the entry pass until the
# conference website settings are published in the admin console
# (Admin > Website > Page content). After that, the published settings are used.
EVENT_NAME=Your Event Name
EVENT_DATE=
EVENT_VENUE=
SUPPORT_CONTACT=

# Set to false to close public registration, whatever the admin console says.
# When true, the "Registration open" switch in the admin console decides.
REGISTRATION_OPEN=true

# Website images (posters, banners, speaker photos).
#   gridfs - stored in this app's MongoDB; survives redeploys and is included in
#            every mongodump. Uses database storage (roughly 100-400 KB per image).
#   local  - stored on this server's disk in ASSET_STORAGE_DIR; only if that disk
#            is persistent and backed up.
# REQUIRED in production (the server refuses to start without it) so the choice
# is made deliberately once the hosting is confirmed.
ASSET_STORAGE=
# Only for ASSET_STORAGE=local. Default: server/.data/assets
ASSET_STORAGE_DIR=

# Country code added to 10-digit mobile numbers entered without one
DEFAULT_COUNTRY_CODE=91
